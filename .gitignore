.DS_Store
__pycache__/
*.py[cod]
.venv/

# Generated mods, firmware, maps, probes and test executables.
out/
diagnostics/digihealth/out/
*.elemod
*.syx
*.bin
release/*.work/
!release/*.elemod

# Stock firmware is supplied by each user, never by this repository.
firmware/
original-os-sysex/

# Elekloader checkout (reference project for Digitone builds, keep out).
# NOTE: no trailing slash — foo/ never matches a symlink checkout.
tools/elekloader
tools/elekloader/mods/*/out/

# Keep only the designated Markdown documents.
*.md
!SOPHIE_OPTIMIZATION_PLAN.md
!README.md
!THIRD_PARTY.md
!DSP.md
!digisophie-dn/README.md
!docs/digitone-mod-template.md

# Never commit vendor manuals (Elektron copyright, user-provided reference).
docs/*.pdf
# Local logs/scratch.
*.log
